ROOT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
.DEFAULT_GOAL := verify

TOOLS := $(ROOT)/tools
OUT := $(ROOT)/out
GEN := $(OUT)/generated
ASM_GEN := $(GEN)/asm
BOUNDARIES := $(ROOT)/layout.tsv
BUILD_INPUTS_STAMP := $(GEN)/build_inputs.stamp

TARGET := $(ROOT)/kh2.elf
TMP_LINK_ELF := $(OUT)/linked.tmp.elf
FAST_LINK_ELF := $(OUT)/linked.fast.tmp.elf
TMP_LD := $(GEN)/kh2.temp.ld
LINK_RSP := $(OUT)/link.rsp
SLPM := $(ROOT)/SLPM_666.75

MAKE_JOBS ?= $(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
KH2_PS2_IMAGE ?= kh2-local/ps2-compiler:3.2-ee-040921-objdiff

PS2_PREP := $(ROOT)/docker/ps2/prepare.sh

CXXFLAGS := -O2 -g0 -x c++ -fno-exceptions -fno-rtti -fpermissive -ffunction-sections
ASFLAGS := -G0
VERIFY_AUTODIFF_COUNT ?= 3
VERIFY_SMALL_DIFF_MAX ?= 32

DOCKER_RUN_PS2 = docker run --rm \
	--platform linux/amd64 \
	-u "$$(id -u):$$(id -g)" \
	-v "$(ROOT):/work" \
	-v "/tmp:/tmp" \
	-w /work \
	"$(KH2_PS2_IMAGE)"

SLPM_MISSING_MSG := error: missing $(SLPM). Put SLPM_666.75 at repo root.
OBJDIFF_CONFIG_PATH := $(ROOT)/objdiff.json

define require_slpm
@test -f $(SLPM) || (echo "$(SLPM_MISSING_MSG)" >&2; exit 1)
endef

.PHONY: all build verify clean distclean preflight ps2-docker toolchain-check \
        regen-layout progress inner-all objdiff-config objdiff-report FORCE

all: build

build: $(TARGET) $(OBJDIFF_CONFIG_PATH)
	@python3 $(TOOLS)/objdiff.py progress --elf $(TARGET) --skip-report

$(SLPM):
	@echo "$(SLPM_MISSING_MSG)" >&2
	@exit 1

preflight: $(SLPM)
	@$(PS2_PREP)

ps2-docker:
	@$(ROOT)/docker/ps2/prepare.sh --build

# This include is generated by tools/build_elf.py.
ifneq ($(filter clean distclean ps2-docker toolchain-check,$(MAKECMDGOALS)),)
else
-include $(GEN)/objects.mk
endif

$(BOUNDARIES):
	@echo "error: missing $(BOUNDARIES)" >&2
	@exit 1

$(GEN)/objects.mk $(GEN)/layout_status.tsv $(GEN)/symbols.ld: $(BOUNDARIES) $(ROOT)/functions.tsv $(TOOLS)/build_elf.py $(TOOLS)/common.py
	@mkdir -p $(GEN)
	@python3 $(TOOLS)/build_elf.py objects

$(BUILD_INPUTS_STAMP): FORCE $(TOOLS)/build_elf.py
	@mkdir -p $(GEN)
	@python3 $(TOOLS)/build_elf.py inputs-stamp --out $@

regen-layout: $(GEN)/objects.mk

$(TMP_LD): $(ROOT)/kh2.ld $(GEN)/cxx_sections.ld
	@mkdir -p $(GEN)
	@sed -e '/\/\* @CXX_SECTIONS@ \*\//r $(GEN)/cxx_sections.ld' \
	     -e '/\/\* @CXX_SECTIONS@ \*\//d' $(ROOT)/kh2.ld > $@

$(TARGET): $(SLPM) $(BOUNDARIES) $(GEN)/objects.mk $(GEN)/layout_status.tsv $(GEN)/symbols.ld $(ROOT)/functions.tsv $(ROOT)/kh2.ld \
           $(TOOLS)/build_elf.py $(TOOLS)/common.py $(BUILD_INPUTS_STAMP)
	@$(PS2_PREP)
	@$(DOCKER_RUN_PS2) bash -lc '/usr/bin/make -j"$(MAKE_JOBS)" inner-all'
	@echo "Built $@"

$(OBJDIFF_CONFIG_PATH): $(TARGET) $(BOUNDARIES) $(GEN)/objects.mk $(GEN)/layout_status.tsv $(GEN)/symbols.ld $(ROOT)/functions.tsv $(TOOLS)/objdiff.py $(TOOLS)/common.py
	@python3 $(TOOLS)/objdiff.py config --elf $(TARGET)

inner-all: $(GEN)/objects.mk $(ORDERED_OBJS)
	@python3 $(TOOLS)/build_elf.py link-sections
	$(file >$(LINK_RSP),INPUT ( $(ORDERED_OBJS) ))
	@if ! python3 $(TOOLS)/build_elf.py fast-link --linked-elf $(FAST_LINK_ELF) --out-elf $(TARGET) --full-linked-elf $(TMP_LINK_ELF); then \
		sed -e '/\/\* @CXX_SECTIONS@ \*\//r $(GEN)/cxx_sections.ld' \
		    -e '/\/\* @CXX_SECTIONS@ \*\//d' $(ROOT)/kh2.ld > $(TMP_LD); \
		/opt/ps2/gcc/bin/ee-ld --no-check-sections -T $(TMP_LD) -T $(LINK_RSP) -o $(TMP_LINK_ELF) -L/opt/ps2/gcc/lib/gcc-lib/ee/3.2-ee-040921 -lgcc; \
		python3 $(TOOLS)/build_elf.py normalize --linked-elf $(TMP_LINK_ELF) --out-elf $(TARGET); \
	fi

out/build/%.o: %.cpp
	@mkdir -p $(dir $@)
	@/opt/ps2/gcc/bin/ee-g++ $(CXXFLAGS) -c -o $@ $<

# FUN_00230878 has no 8-byte padding before its loop-tail label (the label
# follows a return), which -O2 would add. Build its object without jump
# alignment.
out/build/src/anon/batch_20261019_g.o: CXXFLAGS += -falign-jumps=1
# FUN_00111278 likewise ends without the loop-tail alignment padding.
out/build/src/anon/agent_f1_20261019.o: CXXFLAGS += -falign-jumps=1
# FUN_00183768 is not a multiple of 8 bytes and ends in jr ra; skip the trailing function padding.
out/build/src/anon/agent_f5_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_v3_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_a13_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_b13_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_b12_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_a15_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_a14_20261019.o: CXXFLAGS += -falign-jumps=1
out/build/src/anon/agent_a12_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_c13_20261019.o: CXXFLAGS += -falign-functions=1
out/build/src/anon/agent_c10_20261019.o: CXXFLAGS += -falign-functions=1 -falign-jumps=1
out/build/src/anon/agent_c11_20261019.o: CXXFLAGS += -falign-functions=1 -falign-jumps=1
out/build/src/anon/agent_k12_20261019.o: CXXFLAGS += -falign-functions=1
